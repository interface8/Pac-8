# ─── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pac8?schema=public"

# ─── Auth / JWT ───────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="1d"

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe (get keys from https://dashboard.stripe.com/test/apikeys) ─
# Secret key starts with sk_test_ (test) or sk_live_ (production)
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
# Webhook secret from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
# Publishable key starts with pk_test_ (test) or pk_live_ (production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
